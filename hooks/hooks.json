{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "timeout": 14,
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/start.sh\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "shell": "bash",
            "async": true,
            "timeout": 3,
            "command": "curl -s -m 2 -X POST --data-binary @- \"http://127.0.0.1:8899/api/hook?e=start\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "async": true,
            "timeout": 3,
            "command": "curl -s -m 2 -X POST --data-binary @- \"http://127.0.0.1:8899/api/hook?e=prompt\" >/dev/null 2>&1 || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "timeout": 3,
            "command": "curl -s -m 2 -X POST --data-binary @- \"http://127.0.0.1:8899/api/hook?e=ask\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "async": true,
            "timeout": 3,
            "command": "curl -s -m 2 -X POST --data-binary @- \"http://127.0.0.1:8899/api/hook?e=pre\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "async": true,
            "timeout": 3,
            "command": "curl -s -m 2 -X POST --data-binary @- \"http://127.0.0.1:8899/api/hook?e=post\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "async": true,
            "timeout": 3,
            "command": "curl -s -m 2 -X POST --data-binary @- \"http://127.0.0.1:8899/api/hook?e=post\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "async": true,
            "timeout": 3,
            "command": "curl -s -m 2 -X POST --data-binary @- \"http://127.0.0.1:8899/api/hook?e=perm\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "async": true,
            "timeout": 3,
            "command": "curl -s -m 2 -X POST --data-binary @- \"http://127.0.0.1:8899/api/hook?e=notify\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "async": true,
            "timeout": 3,
            "command": "curl -s -m 2 -X POST --data-binary @- \"http://127.0.0.1:8899/api/hook?e=stop\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
